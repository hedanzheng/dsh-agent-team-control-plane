{
  "name": "@local/agent-team-control-plane",
  "version": "0.5.3",
  "private": true,
  "type": "module",
  "description": "Agent Team Control Plane MVP Phase 5 for DeepSeek Harness Desktop",
  "engines": {
    "dsh": "0.2.1-rc.2"
  },
  "exports": {
    ".": "./src/host/index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "src/**/*.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hedanzheng/dsh-agent-team-control-plane.git"
  },
  "homepage": "https://github.com/hedanzheng/dsh-agent-team-control-plane#readme",
  "bugs": {
    "url": "https://github.com/hedanzheng/dsh-agent-team-control-plane/issues"
  },
  "license": "MIT",
  "scripts": {
    "test": "node --test --test-concurrency=1 test/unit/*.test.mjs test/integration/*.test.mjs",
    "test:demo": "npm --prefix examples/taskflow-demo test",
    "pack:check": "npm pack --dry-run"
  }
}
